{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/browser.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../../node_modules/.tmp/browser-types",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "../engine" }]
}
