{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/engine.tsbuildinfo",
    "target": "es2023",
    /* No DOM. The engine must not compile against browser globals — if a
       platform type is needed here, the design is wrong. */
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    /* Composite so the web and test projects can reference it and get proper
       build ordering. Declarations only — the bundler compiles the sources. */
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../../node_modules/.tmp/engine-types",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
