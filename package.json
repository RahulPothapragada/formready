{
  "name": "formready",
  "private": true,
  "version": "0.1.0",
  "description": "Show the requirements. Get your document ready.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "setup:ocr": "node scripts/setup-ocr-assets.mjs",
    "setup:icons": "node scripts/make-icons.mjs",
    "setup": "npm run setup:ocr && npm run setup:icons",
    "verify:browser": "node scripts/verify-in-browser.mjs",
    "verify:offline": "node scripts/verify-in-browser.mjs --offline"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
